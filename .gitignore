*.pyc
.pytest_cache/
*.egg-info/
.env
*.~lock.*
.neon
.env.local

# Web research evaluation: the benchmark, caches and pass outputs are artifacts, never commits (public repo)
benchmark/
benchmark-all/
eval-cache/
pass/
